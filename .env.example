# TMDB (The Movie Database) — https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=your_tmdb_api_key_here
VITE_TMDB_API_BASE_URL=https://api.themoviedb.org/3
VITE_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500
VITE_BACKDROP_BASE_URL=https://image.tmdb.org/t/p/original

# OMDb (Open Movie Database) — https://www.omdbapi.com/apikey.aspx
VITE_OMDB_API_KEY=your_omdb_api_key_here

# YouTube Data API v3 — https://console.cloud.google.com/apis/library/youtube.googleapis.com
VITE_YOUTUBE_API_KEY=your_youtube_api_key_here

# RapidAPI — Movies Database — https://rapidapi.com/SAdrian/api/moviesdatabase
VITE_RAPIDAPI_KEY=your_rapidapi_key_here

# Pexels Videos API — https://www.pexels.com/api/
VITE_PEXELS_API_KEY=your_pexels_api_key_here

# Pixabay API — https://pixabay.com/api/docs/
VITE_PIXABAY_API_KEY=your_pixabay_api_key_here
